{
  "expo": {
    "name": "Progress Camera",
    "slug": "progress-camera",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aldrinjenson.progresscamera"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0A09",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.aldrinjenson.progresscamera",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Progress Camera uses the camera to take your progress photos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Progress Camera saves your photos to the gallery as a backup.",
          "savePhotosPermission": "Progress Camera saves your photos to the gallery as a backup.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "color": "#FFD60A"
        }
      ],
      "./plugins/withVolumeShutter",
      "./plugins/withReleaseSigning"
    ],
    "backgroundColor": "#0B0A09"
  }
}